# Salin file ini menjadi .env.local dan isi nilainya
# JANGAN commit .env.local ke git!

# Supabase — ambil dari dashboard.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# JWT Secret — generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=ganti-dengan-string-random-min-32-karakter

# App URL
NEXT_PUBLIC_APP_URL=https://nama-app.vercel.app
